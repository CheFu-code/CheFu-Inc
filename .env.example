# ==============================================================================
# CHEFU TECHNOLOGIES (company-app) ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ── Public App & Service URLs (Exposed to browser) ──
NEXT_PUBLIC_API_BASE_URL=https://api.chefu.co.za
NEXT_PUBLIC_ACCOUNT_APP_URL=https://myaccount.chefu.co.za
NEXT_PUBLIC_CHEFU_ACCOUNT_URL=https://myaccount.chefu.co.za
NEXT_PUBLIC_ALLOWED_RETURN_ORIGINS=https://api.chefu.co.za,https://chefu.co.za,https://myaccount.chefu.co.za,https://academy.chefu.co.za,https://flow.chefu.co.za,https://music.chefu.co.za,https://quantum.chefu.co.za
NEXT_PUBLIC_CONSULTATION_URL=https://calendar.app.google/your_consultation_link

# ── Optional Rate Limiting (Upstash Redis) ──
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here