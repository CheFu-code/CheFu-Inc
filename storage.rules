rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.isAdmin == true;
    }

    match /membershipApplications/{applicationId}/cv/{fileName} {
      allow read: if isAdmin();
      allow create: if resource == null
        && firestore.get(/databases/(default)/documents/membershipApplications/$(applicationId)).data.consentGiven == true
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
      allow update, delete: if isAdmin();
    }
  }
}
